# ✅ Local development environment variables

# Secret key (safe for local dev, not for production)
DJANGO_SECRET_KEY=django-insecure-local-dev-key

# Debug ON for local development
DEBUG=True

# Local database (SQLite is simplest for dev)
DATABASE_URL=sqlite:///db.sqlite3

# Allowed hosts (local only)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (local dev server)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Email backend (console prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@habittracker.com
